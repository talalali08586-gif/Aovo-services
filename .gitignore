# Raw client assets — never committed, live in ../_client/ outside this repo
_client/

# Raw audio — only optimised MP3s in audio/ are committed
*.wav

# Dependencies (kept for safety; this project has no build step / no npm packages)
node_modules/

# Local deployment bundles (zips made for uploading to the host)
*.zip

# Windows
Thumbs.db

# Per-developer editor/tool settings — machine-specific, not project config
.claude/settings.local.json

# Form delivery settings: holds the mailbox password, never committed.
# Copy api/config.example.php to api/config.php on the server.
api/config.php

# Audio uploaded by visitors through the Sample Test Restore form
api/uploads/*
!api/uploads/.htaccess
